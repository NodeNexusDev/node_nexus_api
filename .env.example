# App
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/node_nexus # async SQLAlchemy URL
ENVIRONMENT=production           # development|test|production
SECRET_KEY=0123456789abcdef0123456789ABCDEF # 32 chars — generate: openssl rand -hex 16
DEBUG=false                      # true only in dev/test
LOG_LEVEL=INFO                   # DEBUG|INFO|WARNING|ERROR
PORT=8000                        # API port inside container
HOST_PORT=8000                   # host -> PORT (compose only)
IMAGE_TAG=latest                 # GHCR image tag: latest, 1.7.1, 1.7, sha-<commit>

# Security — API Key / Superuser / JWT / Encryption
MASTER_API_KEY=abcdef0123456789ABCDEF0123456789 # 32 chars — generate: openssl rand -hex 16
INITIAL_SUPERUSER_EMAIL=admin@example.com
INITIAL_SUPERUSER_PASSWORD=Admin12345678    # 13 chars — generate: openssl rand -base64 12
ACCESS_TOKEN_EXPIRE_MINUTES=15       # JWT access TTL, min
REFRESH_TOKEN_EXPIRE_DAYS=7          # JWT refresh TTL, days
REFRESH_TOKEN_COOKIE_MAX_AGE=604800  # refresh cookie Max-Age, sec (7 days)
ENCRYPTION_SALT=0123456789abcdef     # 16 chars — generate: openssl rand -hex 8

# CORS
CORS_ORIGINS=["http://localhost:3000"] # allowed origins, * forbidden in production

# SSH host verification — strict=true required in production (app/core/config.py)
SSH_STRICT_HOST_KEY_CHECKING=true        # true=verify known_hosts, false only in test
SSH_KNOWN_HOSTS_PATH=/app/.ssh/known_hosts # OpenSSH file, volume known_hosts (compose)
SSH_KNOWN_HOSTS_AUTO_ADD=true           # true=ssh-keyscan on node create/update and POST /nodes/{id}/refresh-host-key
SSH_KNOWN_HOSTS_FETCH_TIMEOUT=10         # ssh-keyscan timeout, sec

# Scheduler
SCHEDULER_ENABLED=true                   # true=run schedules on this instance
SCHEDULER_OWNERSHIP_POLL_SECONDS=5.0       # advisory lock poll, sec
SCHEDULER_RECONCILIATION_INTERVAL_SECONDS=10.0 # DB<->runtime sync, sec

# HTTP / Rate limiting / Audit / Migrations
REQUEST_TIMEOUT=300                      # global HTTP timeout, sec
RATE_LIMIT_REQUESTS=100                  # requests per window
RATE_LIMIT_WINDOW=60                     # window, sec
RATE_LIMIT_MAX_CLIENTS=10000             # in-memory buckets
AUDIT_LOG_RETENTION_DAYS=90              # audit retention, 0=disable
AUTO_MIGRATE=true                        # true=alembic upgrade head on startup

# Observability — Prometheus / OpenTelemetry
PROMETHEUS_ENABLED=true                  # true=expose /metrics
PROMETHEUS_PATH=/metrics
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317      # OTLP gRPC
OTEL_SERVICE_NAME=node-nexus-api

# E2E (test only)
E2E_ENABLED=false                    # true only in test, forbidden in production

# PostgreSQL (compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_nexus
