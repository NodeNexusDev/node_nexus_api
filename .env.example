# App
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/node_nexus
SECRET_KEY=change-me-in-production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
HOST_PORT=8000

# API Key Authentication
MASTER_API_KEY=change-me-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Encryption
ENCRYPTION_SALT=change-me-in-production

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Rate limiting (requests per window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Audit log retention (days, 0 = disabled)
AUDIT_LOG_RETENTION_DAYS=90

# Auto-migration on startup (disable for manual migration control)
AUTO_MIGRATE=true

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics

# OpenTelemetry tracing (disabled by default)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=node-nexus-api

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_nexus
