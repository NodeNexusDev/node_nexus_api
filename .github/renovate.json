{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "python dependencies"
    },
    {
      "matchDepNames": ["uv"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["uv.lock"],
      "matchStrings": ["name = \"(?<depName>[^\"]+)\"\\nversion = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi"
    }
  ]
}
