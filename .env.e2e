# App (E2E)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/node_nexus_e2e
SECRET_KEY=e2e-test-secret-key-for-encryption
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST_PORT_E2E=8001

# API Key Authentication
MASTER_API_KEY=e2e-master-key-12345

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Encryption
ENCRYPTION_SALT=e2e-test-salt

# Rate limiting (high for E2E tests)
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW=60

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_nexus_e2e
