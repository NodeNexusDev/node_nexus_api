# App (E2E)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/node_nexus_e2e
SECRET_KEY=e2e-test-secret-key-for-encryption
REDIS_URL=redis://redis:6379/0
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST_PORT_E2E=8001

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SSH=10/minute

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_nexus_e2e
