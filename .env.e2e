# App (E2E)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/node_nexus_e2e
SECRET_KEY=e2e-test-secret-key-for-encryption
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST_PORT_E2E=8001

# API Key Authentication
MASTER_API_KEY=e2e-master-key-12345

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Encryption
ENCRYPTION_SALT=e2e-test-salt
SSH_STRICT_HOST_KEY_CHECKING=false

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Rate limiting (high for E2E tests)
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW=60

# Audit log retention (keep all in E2E)
AUDIT_LOG_RETENTION_DAYS=0

# Auto-migration on startup
AUTO_MIGRATE=true

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics

# OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=node-nexus-api

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_nexus_e2e
