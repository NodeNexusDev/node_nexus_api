FROM lscr.io/linuxserver/openssh-server:latest

USER root

# Install Docker CLI (for communicating with dind daemon)
RUN apk add --no-cache docker-cli

# Ensure DOCKER_HOST is available in SSH sessions.
# /etc/environment is sourced by PAM on SSH login (Alpine/linuxserver image).
ENV DOCKER_HOST=tcp://dind:2375
RUN echo "DOCKER_HOST=tcp://dind:2375" >> /etc/environment
