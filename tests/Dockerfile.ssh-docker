FROM lscr.io/linuxserver/openssh-server:latest

USER root

# Install Docker CLI (for communicating with dind daemon)
RUN apk add --no-cache docker-cli

# Ensure Docker CLI uses dind in non-interactive SSH sessions.
ENV DOCKER_HOST=tcp://dind:2375
RUN mv /usr/bin/docker /usr/bin/docker-cli \
    && printf '#!/bin/sh\nDOCKER_HOST="${DOCKER_HOST:-tcp://dind:2375}" exec /usr/bin/docker-cli "$@"\n' \
        > /usr/bin/docker \
    && chmod +x /usr/bin/docker
